# Local sync credentials. Keep this file as a template; put real values in .env.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_API_VERSION=v26.0
INSTAGRAM_MAX_PAGES=2

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Keep new live imports in draft until the editorial workflow is verified.
AUTO_PUBLISH=false

# Replace with the public origin before building for deployment.
SITE_URL=https://example.org

# Required only for npm run deploy.
NEOCITIES_API_KEY=
