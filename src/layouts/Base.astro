---
import { siteConfig } from "../config/site";
import { absoluteUrl, jsonLd, organization } from "../lib/seo";
import "../styles/global.css";
interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  article?: boolean;
  publishedAt?: string;
  updatedAt?: string;
}
const {
  title,
  description = siteConfig.description,
  image,
  imageAlt,
  article = false,
  publishedAt,
  updatedAt,
} = Astro.props;
const canonical = absoluteUrl(Astro.url.pathname);
const fullTitle = `${title} · ${siteConfig.shortName}`;
---

<!doctype html>
<html lang={siteConfig.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteConfig.name}
      href="/rss.xml"
    />
    <meta name="theme-color" content={siteConfig.accentColor} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content={siteConfig.locale.replace("-", "_")} />
    <meta
      name="twitter:card"
      content={image ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {
      image && (
        <>
          <>
            <meta property="og:image" content={absoluteUrl(image)} />
            <meta property="og:image:alt" content={imageAlt} />
            <meta name="twitter:image" content={absoluteUrl(image)} />
            <meta name="twitter:image:alt" content={imageAlt} />
          </>
        </>
      )
    }
    {
      publishedAt && (
        <meta property="article:published_time" content={publishedAt} />
      )
    }
    {updatedAt && <meta property="article:modified_time" content={updatedAt} />}
    <script
      is:inline
      type="application/ld+json"
      set:html={jsonLd(organization)}
    />
    <slot name="head" />
  </head>
  <body style={`--green: ${siteConfig.accentColor}`}>
    <a class="skip" href="#main">Zum Inhalt</a>
    <div class="masthead-line wrap">
      <span>{siteConfig.statement}</span><span
        >{siteConfig.town} · Solidarität verbindet</span
      >
    </div>
    <header class="site-header wrap">
      <a class="brand" href="/" aria-label={`${siteConfig.name} – Startseite`}
        ><img
          class="brand-logo"
          src="/brand/sfpo-logo.png"
          alt=""
          width="74"
          height="74"
        /><span class="brand-name"
          >{siteConfig.name}<small>{siteConfig.town}</small></span
        ></a
      >
      <nav aria-label="Hauptnavigation">
        {
          siteConfig.navigation.map((item) => (
            <a
              href={item.href}
              aria-current={
                Astro.url.pathname === item.href ||
                (item.href === "/posts/" &&
                  Astro.url.pathname.startsWith("/posts/"))
                  ? "page"
                  : undefined
              }
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>
    <main id="main" class="wrap"><slot /></main>
    <footer class="site-footer wrap">
      <div class="footer-statement">
        <span>Stay curious.</span><em>Stay in solidarity.</em><span
          aria-hidden="true">↗</span
        >
      </div>
      <div class="footer-bottom">
        <p>
          <strong>{siteConfig.name}</strong><br />{siteConfig.town} · {
            siteConfig.region
          }
        </p><div>
          <a href={siteConfig.instagramUrl} rel="external">Instagram ↗</a><a
            href="/contact/">Kontakt</a
          ><a href="/rss.xml">RSS abonnieren</a>
          {import.meta.env.DEV && <a href="http://127.0.0.1:4322/">Admin ↗</a>}
        </div>
      </div>
    </footer>
  </body>
</html>
