---
import Base from "../layouts/Base.astro";
---

<Base
  title="Seite nicht gefunden"
  description="Diese Seite wurde nicht gefunden. Zurück zur Startseite oder zu unseren Beiträgen."
>
  <section class="not-found" aria-labelledby="not-found-title">
    <div class="not-found-copy">
      <p class="eyebrow">
        <span class="asterisk" aria-hidden="true">✳</span> 404 / Seite nicht gefunden
      </p>
      <h1 id="not-found-title">Hier geht es<br /><em>nicht weiter.</em></h1>
      <p class="not-found-intro">
        Diese Seite gibt es hier nicht. Vielleicht findest du, was du suchst,
        auf unserer Startseite oder im Beitragsarchiv.
      </p>
      <div class="not-found-actions">
        <a class="button" href="/"
          >Zur Startseite <span aria-hidden="true">↗</span></a
        >
        <a class="text-link" href="/posts/"
          >Beiträge ansehen <span aria-hidden="true">↗</span></a
        >
      </div>
      <span class="scribble not-found-note" aria-hidden="true"
        >Wir sehen uns anderswo ✳</span
      >
    </div>
    <figure class="not-found-art">
      <img
        src="/media/404-illustration.png"
        alt="Gezeichnete Figur mit Kufiya hebt eine Hand; darüber steht ein arabischer Schriftzug."
        width="440"
        height="419"
      />
      <figcaption>SFP / OSNA / 404</figcaption>
    </figure>
  </section>
</Base>

<style>
  .not-found {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(36px, 6vw, 100px);
    align-items: center;
    min-height: 650px;
    padding: 70px 0 90px;
  }
  .not-found-copy {
    min-width: 0;
  }
  h1 {
    margin: 22px 0 30px;
    font-size: clamp(4.5rem, 8vw, 8.5rem);
    line-height: 0.86;
  }
  h1 em {
    color: var(--red);
  }
  .not-found-intro {
    max-width: 560px;
    font-size: clamp(1rem, 1.4vw, 1.2rem);
  }
  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 28px;
    margin-top: 36px;
  }
  .not-found-note {
    display: block;
    margin-top: 55px;
    color: var(--green);
    font-size: 1.2rem;
    transform: rotate(-3deg);
  }
  .not-found-art {
    position: relative;
    margin: 0;
    padding: clamp(22px, 4vw, 55px);
    border: 2px solid var(--ink);
    background: var(--paper-light);
    box-shadow: 12px 12px 0 var(--green);
    transform: rotate(2deg);
  }
  .not-found-art::before {
    content: "✳";
    position: absolute;
    top: -34px;
    right: -26px;
    color: var(--red);
    font: 6rem/1 var(--display);
    transform: rotate(-15deg);
  }
  .not-found-art img {
    width: 100%;
    height: auto;
  }
  figcaption {
    margin-top: 22px;
    font: 500 0.7rem/1.4 var(--mono);
    letter-spacing: 0.12em;
  }
  @media (max-width: 800px) {
    .not-found {
      grid-template-columns: 1fr;
      min-height: 0;
      padding: 55px 0 80px;
    }
    h1 {
      font-size: clamp(4rem, 12vw, 6rem);
    }
    .not-found-note {
      margin-top: 40px;
    }
    .not-found-art {
      width: min(100% - 15px, 560px);
      margin: 0 auto;
    }
  }
</style>
